# ===== LLM provider =====
# DeepSeek API key — required for the default provider (shared across all users).
DEEPSEEK_API_KEY=

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ===== Server =====
# Public base URL — used to derive the OIDC redirect_uri if not set explicitly.
# Must match what your Rauthy client is configured with.
PUBLIC_BASE_URL=http://localhost:3001
# PORT=3001
# DATA_DIR=./data

# ===== Auth / OIDC (Rauthy) =====
# OIDC issuer (no trailing slash). Discovery doc is fetched from {issuer}/.well-known/openid-configuration
OIDC_ISSUER=https://sso.sunrui.ink

# Client credentials — create a "Confidential Client" in Rauthy admin, then fill these in.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Redirect URI registered in Rauthy. Defaults to ${PUBLIC_BASE_URL}/auth/callback if unset.
# OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# Scopes to request. Default: openid profile email
# OIDC_SCOPES=openid profile email

# ===== Session =====
# Random secret (32+ bytes) used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=
