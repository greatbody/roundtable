# ===== 必填 =====

# LLM provider — DeepSeek API key
DEEPSEEK_API_KEY=

# 服务对外暴露的完整 URL（决定 OIDC redirect_uri、Cookie Secure 标记等）
# 本地开发：http://localhost:3001
# 生产：https://roundtable.example.com
PUBLIC_BASE_URL=http://localhost:3001

# OIDC issuer（无尾斜杠）
OIDC_ISSUER=https://sso.sunrui.ink

# 在 Rauthy 后台创建 Confidential Client 后得到
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 会话签名密钥，建议：openssl rand -base64 48
SESSION_SECRET=

# ===== 可选 =====

# 宿主机映射端口，默认 3001
# HOST_PORT=3001
